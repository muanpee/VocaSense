# Local backend configuration. Keep the real .env out of source control.
SUPABASE_URL=https://your-project.supabase.co
# Use the server-side key only in the backend. Supabase's current key naming:
SUPABASE_SECRET_KEY=your-server-side-secret-key
# Legacy deployments may instead use:
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional AI wording enhancement. Never expose this as a VITE_ variable.
GEMINI_API_KEY=your-google-ai-studio-key
GEMINI_MODEL=gemini-3.5-flash-lite
